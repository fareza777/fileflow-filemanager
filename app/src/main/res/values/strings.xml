    <!-- About -->
    <string name="about_title">About FileFlow</string>
    <string name="about_tagline">A file manager that keeps itself tidy.</string>
    <string name="about_body">FileFlow is built for people whose Downloads folder has become a jungle. Browse and move files the normal way, or write rules once and let the app keep everything in its place — with a preview before anything moves, a full log, and one-tap undo.\n\nEverything happens on your device. There is no account, no server, and no upload. The only network traffic is advertising, which never appears while you are browsing your files.</string>
